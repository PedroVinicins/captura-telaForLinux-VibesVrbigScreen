[package]
name = "captura-tela-video"
version = "0.1.0"
edition = "2021"

[dependencies]
# Erros
anyhow = "1"
thiserror = "2"

# Portal Wayland
ashpd = "=0.12.3"

# PipeWire
pipewire = "=0.10.0"

# Janela e renderização
winit = { version = "0.30", features = ["rwh_06"] }
pixels = "0.15"

# Runtime assíncrono
tokio = { version = "1", features = ["rt-multi-thread"] }

# Encoder H.264
openh264 = "=0.9.7"

# Logs
tracing = "0.1"
tracing-subscriber = "0.3"

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1